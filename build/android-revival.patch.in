diff --git a/system/vold/cryptfs.c b/system/vold/cryptfs.c
--- a/system/vold/cryptfs.c
+++ b/system/vold/cryptfs.c
@@ -1712,14 +1712,9 @@
 }
 
 #define DATA_PREP_TIMEOUT 1000
-static int prep_data_fs(void)
+static int wait_for_data_fs(void)
 {
