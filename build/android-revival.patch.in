     </path>
 
     <path name="speaker">
-        <ctl name="RX3 MIX1 INP1" value="RX1" />
-        <ctl name="SPK DAC Switch" value="1" />
+        <!--
+            The MIRROR's AUDIO-HDR feeds a separate stereo amplifier rather
+            than the codec's small handset-speaker output. Route the Android
+            speaker device through the line/headphone pair and assert the
+            external-speaker gate used by this Qualcomm board family.
+        -->
+        <ctl name="QUAT_MI2S_RX Audio Mixer MultiMedia1" value="0" />
+        <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" value="1" />
+        <ctl name="MI2S_RX Channels" value="Two" />
+        <ctl name="RX1 MIX1 INP1" value="RX1" />
+        <ctl name="RX2 MIX1 INP1" value="RX2" />
+        <ctl name="RDAC2 MUX" value="RX2" />
+        <ctl name="HPHL" value="Switch" />
+        <ctl name="HPHR" value="Switch" />
+        <ctl name="Ext Spk Switch" value="On" />
     </path>
 
     <path name="hdmi">
