+    private static final int DRIVER_LOAD_RETRY_INTERVAL_MSECS = 5000;
+    private static final int DRIVER_LOAD_RETRY_TRIES = 12;
+
+    private int mDriverLoadRetryCount = 0;
+
     /* Tracks sequence number on stop failure message */
     private int mSupplicantStopFailureToken = 0;
 
@@ -5992,6 +6004,7 @@ public class WifiStateMachine extends StateMachine implements WifiNative.WifiPno
             switch (message.what) {
                 case CMD_START_SUPPLICANT:
                     if (mWifiNative.loadDriver()) {
