+            if (rc == 0 || (type == CRYPT_TYPE_DEFAULT && no_ui &&
+                            !strcmp(argv[2], "inplace"))) {
                 break;
             } else if (tries == 0) {
                 Process::killProcessesWithOpenFiles(DATA_MNT_POINT, SIGKILL);
